# NextJS Blog Learning Platform - Environment Variables
# Copy this file to .env.local and update with your actual values

# =============================================================================
# PUBLIC VARIABLES (Accessible in browser via process.env.NEXT_PUBLIC_*)
# =============================================================================

# Site Configuration
NEXT_PUBLIC_SITE_NAME="NextJS Blog"
# Example: "My Awesome Blog", "Tech Learning Hub"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production example: "https://your-domain.vercel.app"
# Used for: Canonical URLs, OpenGraph tags, sitemap generation

NEXT_PUBLIC_API_URL="http://localhost:3000/api"
# Production example: "https://your-domain.vercel.app/api"
# Used for: Client-side API calls (comments, contact form)

# =============================================================================
# PRIVATE VARIABLES (Server-only, NOT accessible in browser)
# =============================================================================

# Add any server-only variables here (database URLs, API keys, secrets)
# Example:
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
# API_SECRET_KEY="your-secret-key-here"

# =============================================================================
# NOTES
# =============================================================================
# - NEXT_PUBLIC_* variables are embedded in the browser bundle
# - Never put secrets in NEXT_PUBLIC_* variables
# - Changes to env vars require restarting the dev server
# - Production deployments should set these in Vercel/hosting platform
